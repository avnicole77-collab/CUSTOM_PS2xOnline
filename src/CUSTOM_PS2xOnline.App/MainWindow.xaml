<Window x:Class="CUSTOM_PS2xOnline.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CUSTOM_PS2xOnline.App"
        mc:Ignorable="d"
        Title="CUSTOM PS2xOnline"
        Height="760" Width="1280"
        Background="#0B0D12" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#141821" BorderBrush="#1B2030" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CUSTOM PS2xOnline" FontWeight="Bold" FontSize="20" Foreground="#FFFFFF" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HostStatus}" Foreground="#35C978" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding NetworkStatus}" Foreground="#AAB2C5" Margin="0,0,12,0" />
                    <TextBlock Text="User: Local Admin" Foreground="#AAB2C5" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#141821" BorderBrush="#1B2030" BorderThickness="0,0,1,0">
                <StackPanel Margin="12">
                    <TextBlock Text="Dashboard" Margin="0,8" Foreground="#FFFFFF" />
                    <TextBlock Text="Game Library" Margin="0,8" Foreground="#AAB2C5" />
                    <TextBlock Text="Rooms" Margin="0,8" Foreground="#AAB2C5" />
                    <TextBlock Text="Controllers" Margin="0,8" Foreground="#AAB2C5" />
                    <TextBlock Text="Settings" Margin="0,8" Foreground="#AAB2C5" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#141821" CornerRadius="16" Padding="16" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Create Room" Command="{Binding CreateRoomCommand}" Background="#E83A5F" Foreground="#FFFFFF" Padding="12,8" Margin="0,0,12,0" />
                        <Button Content="Join Room" Command="{Binding JoinRoomCommand}" Background="#1B2030" Foreground="#FFFFFF" Padding="12,8" Margin="0,0,12,0" />
                        <Button Content="Launch Selected Game" Command="{Binding LaunchSelectedGameCommand}" Background="#1B2030" Foreground="#FFFFFF" Padding="12,8" Margin="0,0,12,0" />
                        <Button Content="Refresh Status" Command="{Binding RefreshStatusCommand}" Background="#1B2030" Foreground="#FFFFFF" Padding="12,8" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="#141821" CornerRadius="16" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Launcher Status" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="{Binding StatusText}" Foreground="#35C978" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding Pcsx2Status}" Foreground="#35C978" />
                        <TextBlock Text="{Binding NetworkStatus}" Foreground="#35C978" />
                        <TextBlock Text="{Binding ActiveRoomCode, StringFormat=Active room: {0}}" Foreground="#AAB2C5" />
                        <Separator Margin="0,16,0,12" Background="#1B2030" />
                        <TextBlock Text="Settings" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="PCSX2 executable" Foreground="#AAB2C5" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Pcsx2ExecutablePath, UpdateSourceTrigger=PropertyChanged}" Margin="8,3" />
                            <Button Grid.Row="0" Grid.Column="2" Content="Browse" Click="BrowsePcsx2_Click" Padding="10,4" Margin="4,3" />
                            <TextBlock Grid.Row="1" Text="BIOS folder" Foreground="#AAB2C5" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BiosFolder, UpdateSourceTrigger=PropertyChanged}" Margin="8,3" />
                            <Button Grid.Row="1" Grid.Column="2" Content="Browse" Click="BrowseBios_Click" Padding="10,4" Margin="4,3" />
                            <TextBlock Grid.Row="2" Text="Game folder" Foreground="#AAB2C5" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding GameFolder, UpdateSourceTrigger=PropertyChanged}" Margin="8,3" />
                            <Button Grid.Row="2" Grid.Column="2" Content="Browse" Click="BrowseGames_Click" Padding="10,4" Margin="4,3" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <CheckBox Content="Start games in fullscreen" IsChecked="{Binding DefaultFullscreen}" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Background="#E83A5F" Foreground="#FFFFFF" Padding="12,8" Margin="18,0,0,0" />
                        </StackPanel>
                        <Separator Margin="0,16,0,12" Background="#1B2030" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <DockPanel>
                                    <TextBlock Text="Game Library" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" DockPanel.Dock="Left" />
                                    <Button Content="Scan" Command="{Binding ScanGamesCommand}" Padding="10,4" HorizontalAlignment="Right" />
                                </DockPanel>
                                <ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" Height="150" Margin="0,8,0,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Format, StringFormat=[{0}]}" Foreground="#666666" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Room Session" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock Text="Create a room or enter a 6-8 character code." Foreground="#AAB2C5" TextWrapping="Wrap" Margin="0,8,0,4" />
                                <TextBox Text="{Binding RoomCode, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" MaxLength="8" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Create" Command="{Binding CreateRoomCommand}" Padding="10,5" Margin="0,0,8,0" />
                                    <Button Content="Join" Command="{Binding JoinRoomCommand}" Padding="10,5" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#141821" BorderBrush="#1B2030" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CPU: --" Foreground="#AAB2C5" Margin="0,0,12,0" />
                    <TextBlock Text="RAM: --" Foreground="#AAB2C5" Margin="0,0,12,0" />
                    <TextBlock Text="GPU: --" Foreground="#AAB2C5" Margin="0,0,12,0" />
                    <TextBlock Text="Ping: --" Foreground="#AAB2C5" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding Pcsx2Status}" Foreground="#35C978" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
